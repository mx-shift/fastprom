# Rust toolchain for the FastPROM firmware (fw/) and its web page (web/).
#
# cosmic-toad's tools/rust/Containerfile (its ct-rust image), plus llvm-tools:
# the AG32 target (RV32IMAFC, bare metal), clippy and rustfmt, cargo-cycles
# for the module-cycle check in `make fw-lint`, and llvm-objcopy / llvm-size /
# llvm-nm, which `make fw-build` uses to turn the ELF into the raw .bin that
# AGM's loader programs and to report section sizes. ct-rust has no
# llvm-tools, hence a separate image (fastprom-rust).
#
# For the web page (`make web`, docs/12-web.md): the wasm32-unknown-unknown
# target, and wasm-bindgen-cli at exactly the version of the wasm-bindgen
# crate in fw/Cargo.lock (the CLI refuses a module another version built).
# Change the two together.
FROM docker.io/library/rust:1-slim
RUN rustup target add riscv32imafc-unknown-none-elf wasm32-unknown-unknown && \
    rustup component add clippy rustfmt llvm-tools
RUN for t in llvm-objcopy llvm-size llvm-nm llvm-objdump; do \
        ln -s "$(rustc --print sysroot)/lib/rustlib/x86_64-unknown-linux-gnu/bin/$t" \
              "/usr/local/bin/$t"; \
    done
RUN cargo install --locked cargo-cycles@0.2.0 && \
    cargo install --locked wasm-bindgen-cli@0.2.130 && \
    rm -rf /usr/local/cargo/registry /usr/local/cargo/git
