# Runtime for AGM Supra / AgRV_pio logic tools (they need glibc >= 2.35).
FROM docker.io/library/ubuntu:22.04
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq \
      libx11-6 libxext6 libxrender1 libsm6 libice6 libxtst6 libxi6 libfreetype6 libfontconfig1 \
      libglib2.0-0 libgl1 libegl1 libxkbcommon0 libdbus-1-3 libusb-1.0-0 libncurses6 tcl
